{% extends 'menuGeneral.html.twig' %}

{% block title %}Gestion Des Commandes
{% endblock %}

{% block page_title %}📦 Gestion Des Commandes
{% endblock %}

{% block sidebar %}
	{% include 'approvisionneur/asideApprovisionneur/_sidebar.html.twig' %}
{% endblock %}

{% block mobile_menu %}
	{% include 'approvisionneur/asideApprovisionneur/menu_content.html.twig' %}
{% endblock %}

{% block main_content %}
	<main>
		<div class="d-flex justify-content-center gap-3 mb-4">
			<button type="button" class="btn btn-primary rounded-pill shadow-sm w-100" onclick="showSection('commandeForm', this);">
				Demande Commande
			</button>
			<button type="button" class="btn btn-outline-primary rounded-pill shadow-sm w-100" onclick="showSection('demandesPassees', this);">
				Consulter Demandes Passées
			</button>
		</div>

		<div id="commandeForm" style="display: none;">
			<h2 class="text-center">Demande Commande Commercial</h2>

			{% for message in app.flashes('success') %}
				<div class="alert alert-success text-center rounded-pill">{{ message }}</div>
			{% endfor %}
			<form method="post" action="{{ path('commande_create') }}" class="mx-auto" style="max-width: 600px;" id="commandeFormulaire">
				<input
				type="hidden" name="_token" value="{{ csrf_token('commande_create') }}">

				<!-- Commercial -->
				<div class="mb-3">
					<label for="commercial_id" class="form-label">Commercial</label>
					<select id="commercial_id" name="commercial_id" class="form-control" required>
						<option value="">-- Sélectionnez un commercial --</option>
						{% for commercial in commerciaux %}
							<option value="{{ commercial.id }}" {% if commercial.id == commercial_id %} selected {% endif %}>
								{{ (commercial.user.prenom is defined and commercial.user.nom is defined) ? commercial.user.prenom ~ ' ' ~ commercial.user.nom : 'Commercial sans nom' }}
							</option>
						{% endfor %}
					</select>
				</div>

				<!-- Produits -->
				<div id="produitsContainer">
					<div class="produit-item mb-3">
						<div class="row">
							<div class="col-md-6 mb-3">
								<label for="numero_produit_0" class="form-label">Produit</label>
								<select id="numero_produit_0" name="numero_produit[]" class="form-control" required>
									<option value="">-- Sélectionnez un produit --</option>
									{% for produit in produits %}
										<option value="{{ produit.id }}">
											{{ produit.nomProduit ~ ' - ' ~ produit.categorieProduit }}
										</option>
									{% endfor %}
								</select>

							</div>
							<div class="col-md-6 mb-3">
								<label for="nb_kg_0" class="form-label">Quantité (Kg)</label>
								<input type="number" id="nb_kg_0" name="nb_kg[]" class="form-control" min="1" required>
							</div>
						</div>
					</div>
				</div>

				<!-- Bouton ajout produit -->
				<div class="mb-3">
					<button type="button" class="btn btn-outline-warning w-100 rounded-pill shadow-sm" id="addProduitBtn">
						+ Ajouter un produit
					</button>
				</div>

				<!-- Message -->
				<div class="mb-3">
					<label for="message" class="form-label">Message</label>
					<textarea id="message" name="message" rows="4" class="form-control"></textarea>
				</div>

				<!-- Submit -->
				<button type="submit" class="btn btn-success w-100 rounded-pill shadow-sm">Envoyer</button>
			</form>


		</div>

		<div id="demandesPassees" style="display: none;">
			<h2 class="text-center">Demandes Passées</h2>

			<div class="row justify-content-center mb-3" style="max-width: 600px; margin: auto;">
				<div class="col-auto">
					<label for="invoice_id" class="form-label">
						<strong>Invoice ID</strong>
					</label>
					<input type="text" id="invoice_id" name="invoice_id" class="form-control">
				</div>
				<div class="col-auto">
					<label for="date" class="form-label">
						<strong>Date</strong>
					</label>
					<input type="date" id="date" name="date" class="form-control">
				</div>
			</div>

			<div class="table-responsive">
				<table class="table table-bordered table-hover align-middle">
					<thead
						class="table-light">
						{# <pre>{{ dump(demandes) }}</pre> #}
						<tr>
							<th><input type="checkbox" onclick="toggleSelectAll(this)"></th>
							<th>ID</th>
							<th>Date Demande</th>
							<th>Date Réponse</th>
							<th>Produits</th>
							<th>Fournisseur</th>
							<th>Demandes Acceptée</th>
							<th>Commande Passée</th>
							<th>Commentaire(s)</th>
						</tr>
					</thead>
					<tbody>
						{% for demande in demandes %}
							<tr>
								<td><input type="checkbox" name="selected_demandes[]" value="{{ demande.id }}"></td>
								<td>{{ demande.id }}</td>
								<td>{{ demande.date_demande|date('Y-m-d') }}</td>
								<td>{{ demande.date_demande|date_modify('+10 days')|date('Y-m-d') }}</td>
								<td>{{ demande.produits }}</td>
								<td>{{ demande.minoterie }}</td>
								<td>{{ demande.demande_acceptee ? 'Oui' : 'Non' }}</td>
								<td>{{ demande.commande_passee ? 'Oui' : 'Non' }}</td>
								<td>{{ demande.commentaire }}</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="9" class="text-center">Aucune Demande Passée.</td>
							</tr>
						{% endfor %}
					</tbody>

				</table>
			</div>
		</div>
	</main>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
	<script>
		function showSection(sectionId, clickedBtn) {
const sections = ['commandeForm', 'demandesPassees'];
sections.forEach(id => {
document.getElementById(id).style.display = 'none';
});
document.getElementById(sectionId).style.display = 'block';
setActive(clickedBtn);
}

function setActive(clickedBtn) {
document.querySelectorAll('.btn').forEach(btn => btn.classList.remove('active'));
clickedBtn.classList.add('active');
}

function toggleSelectAll(source) {
const checkboxes = document.querySelectorAll('input[name="selected_demandes[]"]');
checkboxes.forEach(cb => cb.checked = source.checked);
}

window.addEventListener('DOMContentLoaded', () => {
showSection('commandeForm', document.querySelector('.btn-primary'));
});

const addProduitBtn = document.getElementById('addProduitBtn');
const produitsContainer = document.getElementById('produitsContainer');
let produitIndex = 1;

addProduitBtn.addEventListener('click', () => {
const produitItem = document.createElement('div');
produitItem.classList.add('produit-item', 'mb-3');
produitItem.innerHTML = `
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="numero_produit_${produitIndex}" class="form-label">Numéro Produit</label>
                    <input type="text" id="numero_produit_${produitIndex}" name="numero_produit[]" class="form-control" required>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="nb_kg_${produitIndex}" class="form-label">Quantité (Kg)</label>
                    <input type="number" id="nb_kg_${produitIndex}" name="nb_kg[]" class="form-control" min="1" required>
                </div>
            </div>
        `;
produitsContainer.appendChild(produitItem);
produitIndex++;
});
	</script>
{% endblock %}
