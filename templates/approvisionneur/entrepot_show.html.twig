{% extends 'menuGeneral.html.twig' %}

{% block title %}Détails De L'entrepôt
{% endblock %}

{% block page_title %}📋 Détails De L'entrepôt
{% endblock %}

{% block sidebar %}
	{% include 'approvisionneur/asideApprovisionneur/_sidebar.html.twig' %}
{% endblock %}

{% block mobile_menu %}
	{% include 'approvisionneur/asideApprovisionneur/menu_content.html.twig' %}
{% endblock %}

{% block main_content %}
	<main>
		<ul style="list-style:none; padding:0; margin:0;">
			<li style="color:black; margin-bottom: 10px;">
				<strong>ID :</strong>
				{{ entrepot.id }}</li>
			<li style="color:black; margin-bottom: 10px;">
				<strong>Nom :</strong>
				{{entrepot.nomEntrepot }}</li>
			<li style="color:black; margin-bottom: 10px;">
				<strong>Localisation :</strong>
				{% if entrepot.adresse is not null %}
					{{ entrepot.adresse.numRue }}
					{{ entrepot.adresse.nomRue }},<br>
					{{ entrepot.adresse.codePostal }}
					{{ entrepot.adresse.ville }},<br>
					France
				{% else %}
					<em>Adresse non disponible</em>
				{% endif %}
			</li>

			<li style="margin-bottom: 10px;">
				<a href="{{ path('entrepot') }}" style="text-decoration:none; color:black; font-weight:bold;">← Retour à la liste</a>
			</li>
		</ul>

		<h2 style="text-align:center;">{{ entrepot.nomEntrepot }}</h2>

		<table class="table table-bordered table-hover align-middle">
			<thead>
				<tr>
					<th>✓</th>
					<th>ID</th>
					<th>Produit</th>
					<th>Date Dernière Commande</th>
					<th>Catégorie</th>
					<th>Stock</th>
					<th>Action</th>
				</tr>
			</thead>
			<tbody>
				{% if produits is not empty %}
					{% for produit in produits %}
						<tr>
							<td><input type="checkbox"/></td>
							<td>{{ produit.id ?? 'N/A' }}</td>
							<td>{{ produit.nom_produit }}</td>

							<td>{{ produit.categorie_produit ?? 'N/A' }}</td>

							{# Calcul du pourcentage de stock #}
							{% set max_stock = 300 %}
							{% set percent = (produit.stock / max_stock) * 100 %}
							{% set color = percent < 30 ? '#e74c3c' : (percent < 70 ? '#f1c40f' : '#2ecc71') %}

							<td>
								<div style="background:#ddd; width:100px; height:15px; border-radius:5px; overflow:hidden;">
									<div style="width:{{ percent }}%; background-color:{{ color }}; height:100%;"></div>
								</div>
								<small>{{ produit.stock|default(0)|number_format(2, ',', ' ') }}
									({{ percent|round(0) }}%)</small>
							</td>

							<td>{{ produit.quantite_reserve|default(0)|number_format(2, ',', ' ') }}</td>

							<td>
								<button type="button" class="btn-ajout" data-id="{{ produit.id ?? '' }}" data-produit="{{ produit.nom_produit }}" data-quantite="1" style="display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 5px; color: black; background: none; border: none; font-weight: bold; width: 60px; cursor: pointer;">
									<span style="font-size: 0.8rem;">Ajout</span>
									<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
										<circle cx="9" cy="21" r="1.5"/>
										<circle cx="20" cy="21" r="1.5"/>
										<path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
									</svg>
								</button>
							</td>
						</tr>
					{% endfor %}
				{% else %}
					<tr>
						<td colspan="7" class="text-center">Aucun produit valide à afficher.</td>
					</tr>
				{% endif %}


			</tbody>
		</table>

		<div id="form-overlay" style="display:none; position: fixed; top:0; left:0; width: 100%; height:100%; background: rgba(0,0,0,0.5); z-index: 1000;"></div>

		<div id="form-section" class="form-container" style="display:none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);background: white; padding: 20px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.3); z-index: 1001; width: 450px; font-family: sans-serif;">
			<h3 style="text-align: center; margin-bottom: 20px;">Ajouter Commande Commercial</h3>
			<form method="post" action="{{ path('entrepot_show', {'id': entrepot.id}) }}">
				<input
				type="hidden" name="entrepot_id" id="form-entrepot-id" value="{{ entrepot.id }}"/>
				{# Token CSRF pour protéger la soumission du formulaire #}
				<input type="hidden" name="_token" value="{{ csrf_token('entrepot_show') }}">
				<div class="form-full" style="margin-bottom: 15px;">
					<label>Nom Produit</label>
					<input type="text" name="produit" id="form-produit" required style="width: 100%; padding: 10px; font-size: 1rem; border: 1px solid #ccc; border-radius: 5px;"/>
				</div>
				<div class="form-row" style="display:flex; gap: 10px; margin-bottom: 15px;">
					<div style="flex:1;">
						<label>Réf Produit</label>
						<input type="text" id="form-ref" name="ref" required style="width: 100%; padding: 10px; font-size: 1rem; border: 1px solid #ccc; border-radius: 5px;"/>
					</div>
					<div style="flex:1;">
						<label>Quantité</label>
						<input type="number" id="form-quantite" name="quantite" min="1" required style="width: 100%; padding: 10px; font-size: 1rem; border: 1px solid #ccc; border-radius: 5px;"/>
					</div>
				</div>
				<div class="form-full" style="margin-bottom: 15px;">
					<label>Message</label>
					<textarea name="message" style="width: 100%; padding: 10px; font-size: 1rem; border: 1px solid #ccc; border-radius: 5px; resize: vertical; min-height: 100px;"></textarea>
				</div>
				<button type="submit" style="width: 100%; padding: 12px; background-color: #bf8125; color: black; border: none; font-weight: bold; border-radius: 5px; font-size: 1rem; cursor: pointer;">Ajouter Produits</button>
			</form>
		</div>

		<script>
			const formSection = document.getElementById('form-section');
const formOverlay = document.getElementById('form-overlay');

document.querySelectorAll('button.btn-ajout').forEach(button => {
button.addEventListener('click', function (e) {
e.preventDefault();
document.getElementById('form-produit').value = this.dataset.produit || '';
document.getElementById('form-ref').value = this.dataset.ref || '';
document.getElementById('form-quantite').value = this.dataset.quantite || '1';
document.getElementById('form-entrepot-id').value = this.dataset.id || '';
formSection.style.display = 'block';
formOverlay.style.display = 'block';
});
});

formOverlay.addEventListener('click', () => {
formSection.style.display = 'none';
formOverlay.style.display = 'none';
});
		</script>
	</main>
{% endblock %}
