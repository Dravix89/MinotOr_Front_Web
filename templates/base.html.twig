<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>
			{% block title %}Welcome!
			{% endblock %}
		</title>
		<style>
			html,
			body {
				height: 100%;
				margin: 0;
			}

			body {
				background: linear-gradient(rgb(248, 247, 246), #f4f1ea, #ede5d2, #bf8125) !important;
			}
		</style>

		<!-- Favicon -->
		<link
		rel="icon" type="image/png" href="{{ asset('images/Logo_Minot_Or.png') }}">


		<!-- Bootstrap CSS CDN -->
		<link
		href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
		<!-- Bootstrap JS Bundle CDN (Popper inclus) -->
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>


		{% block stylesheets %}
			{{ encore_entry_link_tags('app') }}
		{% endblock %}


		{% block javascripts %}
			{{ encore_entry_script_tags('app') }}
			{{ encore_entry_script_tags('menu') }}

			{% if app.request.attributes.get('_route') == 'dashboard_index' %}
				{{ encore_entry_script_tags('dashboard') }}
			{% endif %}
		{% endblock %}

		<script>// window.apiConfig = {
// baseUrl: '/api',
// approvisionneursList: '/api/approvisionneurs',
// approvisionneurDetail: '/api/approvisionneurs/ID_PLACEHOLDER'
// };
	</script>
</head>


<body data-turbo-suppress-warning>
	{% set publicRoutes = ['public_accueil', 'public_apropos', 'public_contact', 'public_produits'] %}

	{% if app.request.attributes.get('_route') in publicRoutes %}
		<nav class="navbar navbar-expand-lg navbar-light bg-light px-4 fixed-top">
			<a class="navbar-brand d-flex align-items-center" href="{{ path('public_accueil') }}">
				<img src="{{ asset('images/Logo_Minot_Or.png') }}" alt="Logo Minot’Or" style="height: 35px;" class="me-2">
				<span>Minot’Or</span>
			</a>

			{# Le bouton hamburger (icône trois barres) : #}
			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
				<span class="navbar-toggler-icon"></span>
			</button>

			{# Le menu qui se cache/affiche : #}
			<div class="collapse navbar-collapse" id="mainNavbar">
				<ul class="navbar-nav ms-auto">
					{% if app.user %}
						<li class="nav-item">
							<a class="nav-link" href="{{ path('client_compte') }}">Mon Compte</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="{{ path('app_logout') }}">Déconnexion</a>
						</li>
					{% else %}
						<li class="nav-item">
							<a class="nav-link" href="{{ path('app_login_client') }}">Espace-Client</a>
						</li>
					{% endif %}
				</ul>
			</div>
		</nav>
	{% endif %}

	{% block body %}{% endblock %}


</body></html>
