{# templates/client/accueil.html.twig #}

{% block title %}Accueil Client Minot’Or
{% endblock %}

{% extends 'menuGeneral.html.twig' %}


{% block page_title %}
	<div style="display: flex; align-items: center; justify-content: center; gap: 1rem; margin: 0; padding: 0;">
		<img src="{{ asset('images/Logo_Minot_Or.png') }}" alt="Logo Minot'Or" style="width: 100px; height: 100px;">
		<h1 style="font-size: 3rem; margin: 0;">Bienvenue Sur Minot’Or</h1>
	</div>
{% endblock %}


{% block sidebar %}
	{% include 'client/asideClient/_sidebar.html.twig' %}
{% endblock %}

{% block mobile_menu %}
	{% include 'client/asideClient/menu_content.html.twig' %}
{% endblock %}
{% block main_content %}


	{% for label, messages in app.flashes %}
		{% for message in messages %}
			<div class="alert alert-{{ label }} flash-message">
				{{ message }}
			</div>
		{% endfor %}
	{% endfor %}


	<h2 class="text-center mb-4 mt-0">🛒 Liste Des Produits</h2>
	<div class="container-fluid px-4">
		<div class="row justify-content-center">

			{% set enviesIds = app.session.get('envies', []) %}

			{% for produit in produits %}
				{% if produit.categorieProduit != 'Pain Invendu' %}
					<div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-4 d-flex">
						<div class="card shadow-sm rounded-4 h-100 w-100 position-relative">
							<img src="{{ asset('images/AlertIMG.png') }}" alt="{{ produit.nomProduit }}" class="img-fluid rounded-top" style="max-height: 150px; object-fit: contain; padding: 1rem; background: #f8f9fa;">

							<button type="button" class="btn btn-link position-absolute top-0 end-0 m-2 p-0" style="z-index: 10;" onclick="ajouterEnvie({{ produit.id }}, this)">
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="{{ produit.id in enviesIds ? 'orange' : 'none' }}" stroke="orange" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-heart">
									<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21.3l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8z"/>
								</svg>
							</button>

							<div class="card-body d-flex flex-column p-3">
								<h5 class="card-title mb-2" style="font-size: 1rem; font-weight: 600;">{{ produit.nomProduit }}</h5>

								<p class="mb-1" style="font-size: 0.85rem;">
									<strong>Prix :</strong>
									{{ produit.prixProduit }}
									€
								</p>
								<p class="mb-2" style="font-size: 0.85rem;">
									<strong>Catégorie :</strong>
									{{ produit.categorieProduit }}
								</p>

								<p class="card-text mb-3" style="font-size: 0.85rem; color: #555;">
									{{ produit.description is defined and produit.description|length > 100 ? produit.description|slice(0, 100) ~ '...' : produit.description|default('') }}
								</p>

								{% if produit.id %}
									<a href="{{ path('client_produit_detail', {id: produit.id}) }}" class="btn btn-outline-secondary btn-sm w-100 mb-2">Voir détails</a>
								{% else %}
									<span class="text-muted">Produit sans détail</span>
								{% endif %}

								{% if produit.id %}
									<form method="post" action="{{ path('client_ajouter_au_devis', {id: produit.id}) }}">
										<input type="hidden" name="_token" value="{{ csrf_token('ajouter_au_devis' ~ produit.id) }}">
										<button type="submit" class="btn btn-success btn-sm w-100">Ajouter au devis</button>
									</form>
								{% else %}
									<button class="btn btn-secondary btn-sm w-100" disabled>Produit non disponible</button>
								{% endif %}
							</div>
						</div>
					</div>
				{% endif %}
			{% endfor %}

			{% for produit in produits %}
				{% if produit.categorieProduit != 'Pain Invendu' %}
					<div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-4 d-flex">
						<div class="card shadow-sm rounded-4 h-100 w-100 position-relative">
							<img src="{{ asset('images/AlertIMG.png') }}" alt="{{ produit.nomProduit }}" class="img-fluid rounded-top" style="max-height: 150px; object-fit: contain; padding: 1rem; background: #f8f9fa;">

							<button type="button" class="btn btn-link position-absolute top-0 end-0 m-2 p-0" style="z-index: 10;" onclick="ajouterEnvie({{ produit.id }}, this)">
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="{{ produit.id in enviesIds ? 'orange' : 'none' }}" stroke="orange" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-heart">
									<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21.3l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8z"/>
								</svg>
							</button>

							<div class="card-body d-flex flex-column p-3">
								<h5 class="card-title mb-2" style="font-size: 1rem; font-weight: 600;">{{ produit.nomProduit }}</h5>

								<p class="mb-1" style="font-size: 0.85rem;">
									<strong>Prix :</strong>
									{{ produit.prixProduit }}
									€
								</p>
								<p class="mb-2" style="font-size: 0.85rem;">
									<strong>Catégorie :</strong>
									{{ produit.categorieProduit }}
								</p>

								<p class="card-text mb-3" style="font-size: 0.85rem; color: #555;">
									{{ produit.description is defined and produit.description|length > 100 ? produit.description|slice(0, 100) ~ '...' : produit.description|default('') }}
								</p>

								{% if produit.id %}
									<a href="{{ path('client_produit_detail', {id: produit.id}) }}" class="btn btn-outline-secondary btn-sm w-100 mb-2">Voir détails</a>
								{% else %}
									<span class="text-muted">Produit sans détail</span>
								{% endif %}

								{% if produit.id %}
									<form method="post" action="{{ path('client_ajouter_au_devis', {id: produit.id}) }}">
										<input type="hidden" name="_token" value="{{ csrf_token('ajouter_au_devis' ~ produit.id) }}">
										<button type="submit" class="btn btn-success btn-sm w-100">Ajouter au devis</button>
									</form>
								{% else %}
									<button class="btn btn-secondary btn-sm w-100" disabled>Produit non disponible</button>
								{% endif %}
							</div>
						</div>
					</div>
				{% endif %}
			{% endfor %}


		</div>
	</div>


	<script>
		function ajouterEnvie(produitId, btn) {
fetch('{{ path("client_ajouter_envie") }}', {
method: 'POST',
headers: {
'Content-Type': 'application/json',
'X-Requested-With': 'XMLHttpRequest',
'X-CSRF-TOKEN': '{{ csrf_token("ajouter_envie") }}'
},
body: JSON.stringify(
{id: produitId}
)
}).then(response => response.json()).then(data => {
if (data.success) { // Toggle fill selon action retournée (à gérer côté serveur)
if (data.action === 'ajout') {
btn.querySelector('svg').setAttribute('fill', 'orange');
} else if (data.action === 'retire') {
btn.querySelector('svg').setAttribute('fill', 'none');
}
// Ne pas désactiver le bouton pour permettre toggle
// btn.disabled = true; (enlevé)
} else {
alert('Erreur : ' + (
data.message || 'Erreur lors de l\'ajout à la liste d\'envies.'
));
}
}).catch(() => alert('Erreur réseau.'));
}
	</script>

	<script>
		document.addEventListener('DOMContentLoaded', function () {
const flashMessages = document.querySelectorAll('.flash-message');
flashMessages.forEach((el) => {
setTimeout(() => {
el.style.transition = 'opacity 0.5s ease-out';
el.style.opacity = '0';
setTimeout(() => el.remove(), 500);
}, 2000); // 2 secondes avant disparition
});
});
	</script>


{% endblock %}
