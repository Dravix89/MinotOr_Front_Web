{# templates/client/asideClient/_sidebar.html.twig #}

<style>
	.menu-item {
		font-weight: normal;
		color: #000;
		text-decoration: none;
		display: flex;
		align-items: center;
	}

	.menu-item:hover,
	.menu-item.active {
		font-weight: 700;
	}
</style>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

{% set current_route = app.request.attributes.get('_route') %}

<!-- Version desktop -->
<div class="container-fluid h-100">
	<div class="row h-100 flex-nowrap">
		<div class="d-flex flex-column gap-3">
			{% include 'client/asideClient/menu_content.html.twig' %}
		</div>
	</div>
</div>


<!-- Version mobile : Offcanvas -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="mobileSidebar" aria-labelledby="mobileSidebarLabel">
	<div class="offcanvas-header">
		<h5 class="offcanvas-title" id="mobileSidebarLabel">Menu</h5>
		<button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
	</div>
	<div class="offcanvas-body d-flex flex-column gap-3">

		<a href="{{ path('client_accueil') }}" class="menu-item{% if current_route == 'client_accueil' %} active{% endif %}">
			<i class="bi bi-house-door me-2"></i>
			Accueil
		</a>

		<a href="{{ path('client_compte') }}" class="menu-item{% if current_route == 'client_compte' %} active{% endif %}">
			<i class="bi bi-person me-2"></i>
			Mon Compte
		</a>

		<a href="{{ path('client_devis') }}" class="menu-item{% if current_route == 'client_devis' %} active{% endif %}">
			<i class="bi bi-journal-text me-2"></i>
			Mon Devis
		</a>

		<a href="{{ path('client_commandes') }}" class="menu-item{% if current_route == 'client_commandes' %} active{% endif %}">
			<i class="bi bi-box-seam me-2"></i>
			Mes commandes
		</a>

		<a href="{{ path('client_suivi_livraison') }}" class="menu-item{% if current_route == 'client_suivi_livraison' %} active{% endif %}">
			<i class="bi bi-truck me-2"></i>
			Suivi livraison
		</a>

		<a href="{{ path('client_pain_invendu') }}" class="menu-item{% if current_route == 'client_pain_invendu' %} active{% endif %}">
			<i class="bi bi-tag me-2"></i>
			Déclarer Pains Invendus
		</a>
	</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
