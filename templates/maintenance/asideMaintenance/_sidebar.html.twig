{# filepath: templates/commercial/asideCommercial/_sidebar.html.twig #}

<style>
	.menu-item {
		font-weight: normal;
		color: #000;
		text-decoration: none;
		display: flex;
		align-items: center;
	}

	.menu-item:hover,
	.menu-item.active {
		font-weight: 700;
	}
</style>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

{% set current_route = app.request.attributes.get('_route') %}

<!-- Version desktop -->
<div class="container-fluid h-100">
	<div class="row h-100 flex-nowrap">
		<div class="d-flex flex-column gap-3">
			{% include 'maintenance/asideMaintenance/menu_content.html.twig' %}
		</div>
	</div>
</div>

<!-- Version mobile : Offcanvas -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="mobileSidebar" aria-labelledby="mobileSidebarLabel">
	<div class="offcanvas-header">
		<h5 class="offcanvas-title" id="mobileSidebarLabel">Menu</h5>
		<button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
	</div>
	<div class="offcanvas-body d-flex flex-column gap-3">
		<a href="{{ path('maintenance_index') }}" class="menu-item{% if current_route == 'maintenance_index' %} active{% endif %}">
			<i class="bi bi-tools me-2"></i>
			Tableau de Bord
		</a>
		<a href="{{ path('maintenance_camions') }}" class="menu-item{% if current_route == 'maintenance_camions' %} active{% endif %}">
			<i class="bi bi-truck me-2"></i>
			Camions à Nettoyer
		</a>
	</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
