<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}Titre par défaut
			{% endblock %}
		</title>
		<!-- Favicon -->
		<link rel="icon" type="image/png" href="{{ asset('images/Logo_Minot_Or.png') }}">

		<meta name="viewport" content="width=device-width, initial-scale=1.0">

		{% block styles %}
			<style>

				* {
					box-sizing: border-box;
				}
				.sf-toolbar-clearer {
					display: none !important;
				}

				html,
				body {
					margin: 0 !important;
					padding: 0 !important;
					font-family: sans-serif;
					overflow-x: hidden; /* empêche scroll horizontal */

				}
				.wrapper {
					display: flex;
					height: 100vh;
					/* background: linear-gradient(rgb(248, 247, 246), #f4f1ea , #ede5d2 , #bf8125); */
					overflow-x: hidden;
				}
				.sidebar {
					max-width: 260px;
					width: 100%;
					flex-shrink: 0;
					background: #fff;
					box-shadow: 2px 0 5px rgb(0 0 0 / 0.1);
					transition: transform 0.3s ease;
				}
				@media(max-width: 768px) {
					.sidebar {
						display: none !important;
					}
				}
				main {
					flex: 1;
					overflow-y: auto;
					padding: 2rem;
					background-color: rgba(255, 255, 255, 0.85);
				}
				.burger-btn {
					display: none;
					position: fixed;
					top: 15px;
					left: 15px;
					z-index: 1100;
					width: 30px;
					height: 22px;
					cursor: pointer;
					flex-direction: column;
					justify-content: space-between;
				}
				.burger-btn span {
					display: block;
					height: 4px;
					background: #333;
					border-radius: 2px;
				}
				@media(max-width: 768px) {
					.burger-btn {
						display: flex;
						left: 15px;
					}
				}


				/* ___________________________________________________________CLIENT */
			</style>
		{% endblock %}

		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	</head>

	<body>
		<div class="burger-btn" id="burgerBtn" aria-label="Menu" role="button" tabindex="0" aria-expanded="false">
			<span></span>
			<span></span>
			<span></span>
		</div>


		<div class="offcanvas offcanvas-start" tabindex="-1" id="mobileSidebar" aria-labelledby="mobileSidebarLabel">
			<div class="offcanvas-header">
				<button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
			</div>
			<div class="offcanvas-body d-flex flex-column gap-1"> {% block mobile_menu %}{% endblock %}
				</div>
			</div>

			<div class="wrapper">
				<div class="sidebar" id="sidebar"> {% block sidebar %}{% endblock %}
					</div>
					<main>
						<h1 class="text-center mb-4 mt-1">
							{% block page_title %}Dashboard
							{% endblock %}
						</h1>
						{% block main_content %}{% endblock %}
					</main>
				</div>

				<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>


				<script>
					function initBurgerMenu() {
const burgerBtn = document.getElementById("burgerBtn");
const mobileSidebar = document.getElementById("mobileSidebar");

if (! burgerBtn || ! mobileSidebar) 
return;



const offcanvasInstance = new bootstrap.Offcanvas(mobileSidebar);

burgerBtn.addEventListener("click", () => {
offcanvasInstance.show();
burgerBtn.setAttribute('aria-expanded', 'true');

});

mobileSidebar.addEventListener("show.bs.offcanvas", () => {
burgerBtn.style.display = "none";
});

mobileSidebar.addEventListener("hidden.bs.offcanvas", () => {
burgerBtn.style.display = "flex";
burgerBtn.setAttribute('aria-expanded', 'false');

});

window.addEventListener("resize", () => {
if (window.innerWidth > 768) {
burgerBtn.style.display = "none";
const offcanvas = bootstrap.Offcanvas.getInstance(mobileSidebar);
if (offcanvas) 
offcanvas.hide();



// Suppression du backdrop Bootstrap
const backdrop = document.querySelector(".offcanvas-backdrop");
if (backdrop) 
backdrop.remove();



} else {
burgerBtn.style.display = "flex";
}
});
}

document.addEventListener("DOMContentLoaded", initBurgerMenu);
document.addEventListener("turbo:load", initBurgerMenu);
				</script>


				{% if app.request.get('_route') starts with 'client_' %}
					<script src="{{ asset('js/tracking.js') }}"></script>
				{% endif %}

			</body>
		</html>
