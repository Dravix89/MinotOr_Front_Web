{% extends 'base.html.twig' %}

{% block title %}Mot De Passe Oublié !
{% endblock %}

{% block body %}

	<style>
		body {
			background: linear-gradient(rgb(248, 247, 246), #f4f1ea, #ede5d2, #bf8125);
			min-height: 100vh;
			margin: 0;
		}

		@media(max-width: 576px) {
			.bg-white.p-4 {
				padding: 1rem !important;
			}
		}


		.my-gradient-btn {
			background: linear-gradient(#f9f8f4, #f3edd9, #e8dfb8, rgba(191, 129, 37, 0.76));
			font-weight: bold;
			border: none;
			padding: 0.75rem 1.5rem;
			border-radius: 8px;
			transition: all 0.3s ease;
			text-shadow: 0 1px 1px rgba(255, 255, 255, 0.4);
			color: #4a3c0a;
		}

		.my-gradient-btn:hover {
			background: linear-gradient(#f7f6f0, #ebe5cc, #d8c88f, rgb(181, 124, 33));
			transform: translateY(-2px);
			box-shadow: 0 4px 6px rgba(0, 0, 0, 0.12);
			cursor: pointer;
			color: #3d3108;
		}

		.my-gradient-btn:active {
			background: linear-gradient(#f4f3ed, #e3ddc0, #cbbf7b, #8d6215);
			transform: translateY(0);
			box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.12);
			color: #2f2506;
		}
	</style>

	<div class="d-flex justify-content-center align-items-center" style="min-height: 100vh;">
		<div class="bg-white p-4 rounded shadow" style="width: 100%; max-width: 500px;">
			<h1 class="text-center mb-4 fw-bold text-dark">Mot De Passe Oublié</h1>
			<form
				method="post">
				{# Jeton CSRF pour sécuriser le formulaire de réinitialisation de mot de passe #}
				<input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password') }}">
				<div class="mb-3">
					<label for="email" class="form-label text-dark fw-semibold">Votre Adresse Email :
					</label>
					<input type="email" id="email" name="email" class="form-control" required autocomplete="email" autofocus>
				</div>
				<button type="submit" class="btn w-100 my-gradient-btn">Envoyer le lien de réinitialisation</button>
			</form>
		</div>
	</div>
{% endblock %}
