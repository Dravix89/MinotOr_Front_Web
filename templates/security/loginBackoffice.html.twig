{% extends 'base.html.twig' %}

{% block title %}Connexion Backoffice
{% endblock %}

{% block body %}
	<link href="https://fonts.googleapis.com/css?family=Montserrat:900&display=swap" rel="stylesheet">

	<style>
		html,
		body {
			background: url('/images/bg-login.jpg') no-repeat center center fixed;
			background-size: cover;
			margin: 0;
			font-family: 'Montserrat', sans-serif;
			height: 100vh;
			display: flex;
			flex-direction: column;
		}

		.login-container {
			background: rgba(255, 255, 255, 0.85);
			padding: 2rem 3rem;
			border-radius: 12px;
			max-width: 500px;
			margin: auto;
			box-shadow: 0 0 15px rgba(0, 0, 0, 0.3);
			display: flex;
			flex-direction: column;
			justify-content: center;
		}

		form {
			max-width: 400px;
			margin: auto;
		}

		h1 {
			font-weight: 900;
			text-align: center;
			margin-bottom: 2rem;
			color: #4a3c0a;
			text-shadow: 0 1px 2px rgba(191, 129, 37, 0.8);
		}

		.form-control {
			border-radius: 8px;
			border: 1.5px solid #bf8125;
			padding: 0.75rem 1rem;
			font-size: 1rem;
			color: #4a3c0a;
			font-weight: 600;
			transition: border-color 0.3s ease;
		}

		.form-control:focus {
			outline: none;
			border-color: #8d6215;
			box-shadow: 0 0 8px rgba(191, 129, 37, 0.5);
		}

		.form-check-label a {
			color: #bf8125;
			text-decoration: none;
			font-weight: 600;
		}

		.form-check-label a:hover {
			text-decoration: underline;
		}

		.form-check-input {
			width: 1.2rem;
			height: 1.2rem;
			cursor: pointer;
		}

		.my-gradient-btn {
			background: linear-gradient(#f9f8f4, #f3edd9, #e8dfb8, rgba(191, 129, 37, 0.76));
			font-weight: bold;
			border: none;
			padding: 0.75rem 1.5rem;
			border-radius: 8px;
			transition: all 0.3s ease;
			text-shadow: 0 1px 1px rgba(255, 255, 255, 0.4);
			color: #4a3c0a;
			width: 100%;
		}

		.my-gradient-btn:hover {
			background: linear-gradient(#f7f6f0, #ebe5cc, #d8c88f, rgb(181, 124, 33));
			transform: translateY(-2px);
			box-shadow: 0 4px 6px rgba(0, 0, 0, 0.12);
			cursor: pointer;
			color: #3d3108;
		}

		.my-gradient-btn:active {
			background: linear-gradient(#f4f3ed, #e3ddc0, #cbbf7b, #8d6215);
			transform: translateY(0);
			box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.12);
			color: #2f2506;
		}

		.text-center a {
			color: #bf8125;
			font-weight: 600;
			text-decoration: none;
		}

		.text-center a:hover {
			text-decoration: underline;
		}

		@media(max-width: 768px) {
			.login-container {
				margin: 3rem 1rem;
				padding: 1.5rem 2rem;
			}
			form {
				max-width: 100%;
			}
		}
	</style>

	<header class="d-flex justify-content-between align-items-center p-3">
		<nav>
			<a href="/" class="me-3 text-decoration-none fw-bold text-dark">Accueil</a>
			<a href="/produits" class="me-3 text-decoration-none fw-bold text-dark">Produits</a>
			<a href="{{ path('app_login_backoffice') }}" class="me-3 text-decoration-none fw-bold text-dark">Backoffice</a>
			{% if app.user %}
				<a href="{{ path('app_logout') }}" class="text-decoration-none fw-bold text-danger">Déconnexion</a>
			{% endif %}
		</nav>
	</header>

	<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
		<div class="login-container">
			<h1>Connexion Backoffice</h1>
			<form method="post" data-turbo="false" autocomplete="off">
				<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
				<div class="mb-3">
					<input type="email" name="_username" class="form-control" placeholder="Email" required autofocus autocomplete="username">
				</div>
				<div class="mb-3">
					<input type="password" name="_password" class="form-control" placeholder="Mot de passe" required autocomplete="current-password">
				</div>
				<div class="form-check mb-3 text-start">
					<input class="form-check-input" type="checkbox" id="rgpd" name="rgpd" required>
					<label class="form-check-label" for="rgpd" style="font-size: 0.9rem;">
						J'accepte la
						<a href="/politique-confidentialite" target="_blank">politique de confidentialité</a>
						et les
						<a href="/conditions-utilisation" target="_blank">conditions d'utilisation</a>.
					</label>
				</div>
				<button type="submit" class="my-gradient-btn">Se Connecter</button>
				<div class="text-center mt-3">
					<a href="{{ path('app_forgot_password_request') }}">Mot de passe oublié ?</a>
				</div>
			</form>
		</div>
	</div>

	<script>
		function parseJwt(token) {
const base64Url = token.split('.')[1];
const base64 = decodeURIComponent(atob(base64Url).split('').map(c => '%' + (
'00' + c.charCodeAt(0).toString(16)
).slice(-2)).join(''));
return JSON.parse(base64);
}
document.querySelector('form').addEventListener('submit', async function (e) {
e.preventDefault();
const email = this._username.value;
const password = this._password.value;
const rgpdChecked = this.rgpd.checked;
if (! rgpdChecked) {
alert("Vous devez accepter la politique de confidentialité et les conditions d'utilisation.");
return;
}
try { // 1. Connexion et récupération du token
const response = await fetch('http://localhost:8000/api/login_check', {
method: 'POST',
headers: {
'Content-Type': 'application/json'
},
body: JSON.stringify(
{username: email, password: password}
)
});

if (! response.ok)
throw new Error('Identifiants invalides');

const data = await response.json();
const token = data.token;
localStorage.setItem('jwt_token', token);
// 2. Récupérer userInfo avec le token
const userResponse = await fetch('http://localhost:8000/api/me', {
headers: {
'Authorization': 'Bearer ' + token
}
});
if (! userResponse.ok)
throw new Error('Impossible de récupérer les infos utilisateur');

const userInfo = await userResponse.json();
// 3. Envoyer token + userId au serveur Symfony
await fetch('/store-token', {
method: 'POST',
headers: {
'Content-Type': 'application/json',
'X-Requested-With': 'XMLHttpRequest'
},
body: JSON.stringify(
{token: token}
)
});
// 4. Décoder token et redirection selon rôle
const decoded = parseJwt(token);
const roles = decoded.roles || [];
if (roles.includes('ROLE_APPROVISIONNEUR')) {
window.location.href = '/dashboard/approvisionneur';
} else if (roles.includes('ROLE_COMMERCIAL')) {
window.location.href = '/dashboard/commercial';
} else if (roles.includes('ROLE_OPERATEUR_MAINTENANCE')) {
window.location.href = '/dashboard/maintenance';
} else {
alert("Aucun rôle reconnu, accès refusé.");
}
} catch (err) {
alert(err.message);
}
});
	</script>
{% endblock %}
